{
  "name": "corevia-promise-plan",
  "version": "0.1.0",
  "private": true,
  "description": "Corevia 약속계획 — 기존 납품 약속과 신규 입찰을 연결하는 AI 운영 시스템",
  "type": "module",
  "scripts": {
    "build": "esbuild ui/workspace.jsx --bundle --minify --legal-comments=eof --outfile=public/workspace.js",
    "predev": "npm run build",
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "data:refresh": "node scripts/prepare-intake-data.mjs",
    "test:scenarios": "node scripts/check-capacity-scenarios.mjs",
    "test:browser": "npm run build && node scripts/check-workflow-browser.mjs",
    "test": "npm run test:scenarios && node scripts/check-worker-security.mjs && npm run test:browser"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.13",
    "@astryxdesign/theme-neutral": "^0.7.13",
    "@stylexjs/stylex": "^0.19.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}

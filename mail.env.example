# 아래 항목을 기존 .env.local에 추가하세요.
# News-for-me와 같은 Gmail OAuth 변수입니다. 네 값은 같은 발신 계정과 OAuth 클라이언트에 맞춰 입력하세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=

# 24자 이상 임의 문자열. 앱의 '자동 발송 키'에도 같은 값을 입력하세요.
COREVIA_MAIL_DISPATCH_TOKEN=

# 실제 발송을 허용할 주소만 소문자로 입력하세요. 쓸 역할만 남겨도 됩니다.
COREVIA_MAIL_RECIPIENTS='{"sales":[],"logistics":[],"production":[],"finance":[],"approver":[]}'
